---
// Jeff Dean's classic latency numbers (order of magnitude, not benchmarks).
// Bars use a log scale; the toggle rescales everything so an L1 hit takes one second.
const rows = [
  { label: 'L1 cache hit', ns: 0.5 },
  { label: 'Branch mispredict', ns: 5 },
  { label: 'L2 cache hit', ns: 7 },
  { label: 'Main memory', ns: 100 },
  { label: 'SSD random read', ns: 150_000 },
  { label: 'Round trip, same datacenter', ns: 500_000 },
  { label: 'Disk seek', ns: 10_000_000 },
  { label: 'Packet across an ocean, round trip', ns: 150_000_000 },
];
const lo = Math.log10(0.1);
const hi = Math.log10(2e8);
const pct = (ns: number) => ((Math.log10(ns) - lo) / (hi - lo)) * 100;

function machine(ns: number) {
  if (ns < 1_000) return `${ns} ns`;
  if (ns < 1_000_000) return `${ns / 1_000} µs`;
  if (ns < 1_000_000_000) return `${ns / 1_000_000} ms`;
  return `${ns / 1e9} s`;
}
---
<figure class="ladder" data-mode="machine">
  <div class="ladder-top">
    <figcaption>How long things take</figcaption>
    <div class="toggle" role="group" aria-label="Time scale">
      <button type="button" data-set="machine" aria-pressed="true">Machine time</button>
      <button type="button" data-set="human" aria-pressed="false">If L1 took 1 second</button>
    </div>
  </div>
  <ol>
    {rows.map((r, i) => (
      <li style={`--w:${pct(r.ns).toFixed(2)}%; --i:${i}`}>
        <span class="label">{r.label}</span>
        <span class="track" aria-hidden="true"><span class="fill"></span></span>
        <span class="value tnum" data-ns={r.ns}>{machine(r.ns)}</span>
      </li>
    ))}
  </ol>
  <p class="note">Classic numbers from Jeff Dean. Orders of magnitude, not benchmarks. Log scale.</p>
</figure>

<script>
  const fig = document.querySelector<HTMLElement>('.ladder');
  const human = (ns: number) => {
    let s = ns * 2; // 0.5 ns -> 1 s
    const units: [number, string][] = [
      [60 * 60 * 24 * 365, 'year'],
      [60 * 60 * 24 * 30, 'month'],
      [60 * 60 * 24, 'day'],
      [60 * 60, 'hour'],
      [60, 'minute'],
      [1, 'second'],
    ];
    for (const [size, name] of units) {
      if (s >= size) {
        const n = s / size;
        const v = n >= 10 ? Math.round(n) : Math.round(n * 10) / 10;
        return `${v} ${name}${v === 1 ? '' : 's'}`;
      }
    }
    return `${s} s`;
  };
  const values = fig?.querySelectorAll<HTMLElement>('.value') ?? [];
  const original = [...values].map((v) => v.textContent ?? '');

  fig?.querySelectorAll<HTMLButtonElement>('.toggle button').forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.dataset.set!;
      fig.dataset.mode = mode;
      fig.querySelectorAll('.toggle button').forEach((b) =>
        b.setAttribute('aria-pressed', String(b === btn)),
      );
      values.forEach((v, i) => {
        v.textContent = mode === 'human' ? human(Number(v.dataset.ns)) : original[i];
      });
    });
  });
</script>

<style>
  .ladder { margin: 0; }
  .ladder-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; margin-bottom: 20px; }
  figcaption { font-weight: 700; font-size: 1.05rem; }

  .toggle { display: inline-flex; border: 1.5px solid currentColor; border-radius: 999px; padding: 3px; }
  .toggle button {
    font: inherit; font-size: 0.875rem; font-weight: 600; color: inherit;
    background: transparent; border: 0; border-radius: 999px; padding: 6px 14px; cursor: pointer;
  }
  .toggle button[aria-pressed='true'] { background: var(--signal); color: #0d1233; }

  ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  li {
    display: grid; align-items: center; gap: 4px 20px;
    grid-template-columns: minmax(130px, 12rem) 1fr 5.5rem;
  }
  .label { font-size: 0.95rem; }
  .track { height: 14px; background: color-mix(in srgb, currentColor 14%, transparent); }
  .fill {
    display: block; height: 100%; width: var(--w); background: currentColor;
    transform-origin: left; animation: grow 700ms cubic-bezier(.2,.7,.2,1) both;
    animation-delay: calc(var(--i) * 70ms + 150ms);
  }
  .value { text-align: right; font-weight: 700; font-size: 0.95rem; }
  .note { margin: 18px 0 0; font-size: 0.85rem; opacity: 0.75; }

  @keyframes grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  @media (max-width: 640px) {
    li { grid-template-columns: 1fr auto; }
    .track { grid-column: 1 / -1; grid-row: 2; height: 10px; }
  }
</style>
