---
import type { CollectionEntry } from 'astro:content';
interface Props { projects: CollectionEntry<'projects'>[] }
const { projects } = Astro.props;
const statusText = { active: 'In progress', paused: 'Paused', done: 'Shipped' } as const;
---
<ul class="projects">
  {projects.map((p) => (
    <li>
      <a href={`/projects/${p.id}/`}>
        <span class="t">{p.data.title}</span>
        <span class="s">{p.data.summary}</span>
        <span class="meta muted"><span>{statusText[p.data.status]}</span><span>{p.data.stack.join(', ')}</span></span>
      </a>
    </li>
  ))}
</ul>

<style>
  .projects { list-style: none; margin: 0; padding: 0; }
  li { border-bottom: 1px solid var(--rule); }
  a { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 6px 32px; padding: 26px 0; text-decoration: none; }
  .t { font-stretch: 118%; font-weight: 800; font-size: clamp(1.5rem, 3vw, 2.25rem); line-height: 1.05; letter-spacing: -0.015em; grid-row: span 2; }
  .s { font-size: 1.05rem; max-width: var(--measure); }
  .meta { font-size: 0.9rem; display: flex; flex-wrap: wrap; gap: 4px 18px; }
  .meta span:first-child { font-weight: 600; color: var(--ink); }
  a:hover .t { color: var(--blue-text); }
  @media (max-width: 720px) { a { grid-template-columns: 1fr; } .t { grid-row: auto; } }
</style>
