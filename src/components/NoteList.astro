---
import type { CollectionEntry } from 'astro:content';
import { statusLabel } from '../lib/content';
interface Props { notes: CollectionEntry<'notes'>[] }
const { notes } = Astro.props;
---
<ul class="notes">
  {notes.map((n) => (
    <li>
      <a href={`/notes/${n.id}/`}>
        <span class="t">{n.data.title}</span>
        <span class="s muted">{n.data.summary}</span>
        <span class={`status ${n.data.status}`}>{statusLabel[n.data.status]}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .notes {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    border-left: 1px solid var(--rule);
  }
  li { border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  a { display: flex; flex-direction: column; gap: 8px; height: 100%; padding: 22px 20px 20px; text-decoration: none; }
  a:hover { background: var(--paper-2); color: inherit; }
  .t { font-stretch: 112%; font-weight: 750; font-size: 1.25rem; line-height: 1.2; }
  .s { font-size: 0.95rem; flex: 1; }
  .status { font-size: 0.85rem; font-weight: 600; display: inline-flex; align-items: center; gap: 8px; }
  .status::before { content: ''; width: 10px; height: 10px; border: 2px solid var(--blue-text); border-radius: 50%; }
  .growing::before { background: linear-gradient(90deg, var(--blue-text) 50%, transparent 50%); }
  .evergreen::before { background: var(--blue-text); }
</style>
