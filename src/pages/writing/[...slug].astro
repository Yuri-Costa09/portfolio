---
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { getPosts, fmtDate } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const words = post.body?.split(/\s+/).length ?? 0;
const minutes = Math.max(1, Math.round(words / 220));
---
<Article title={post.data.title} description={post.data.description} current="writing" back={{ href: '/writing/', label: 'All writing' }}>
  <Fragment slot="meta">
    <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
    <span>{minutes} min read</span>
    {post.data.tags.length > 0 && <span>{post.data.tags.join(', ')}</span>}
  </Fragment>
  <Content />
</Article>
