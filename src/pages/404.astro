---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <div class="wrap nf">
    <h1 class="display">404</h1>
    <p>This page does not exist. It may have been a note that got merged into another one.</p>
    <p><a href="/">Back to the home page</a></p>
  </div>
</Base>
<style>
  .nf { padding-top: clamp(48px, 8vw, 120px); }
  h1 { font-size: clamp(6rem, 25vw, 18rem); line-height: 0.8; color: var(--blue); }
  p { font-size: 1.25rem; max-width: 40ch; }
</style>
