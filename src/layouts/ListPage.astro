---
import Base from './Base.astro';
interface Props {
  title: string;
  lede: string;
  current: 'writing' | 'notes' | 'projects';
}
const { title, lede, current } = Astro.props;
---
<Base title={title} description={lede} current={current}>
  <div class="wrap">
    <header class="top">
      <h1 class="display">{title}</h1>
      <p>{lede}</p>
    </header>
    <slot />
  </div>
</Base>

<style>
  .top { padding-block: clamp(40px, 7vw, 88px) 24px; border-bottom: 3px solid var(--ink); margin-bottom: 8px; }
  h1 { font-size: clamp(3.5rem, 13vw, 9.5rem); font-weight: 900; line-height: 0.82; letter-spacing: -0.04em; margin-left: -0.03em; }
  p { font-size: clamp(1.1rem, 1.8vw, 1.3rem); max-width: 48ch; margin: 24px 0 0; color: var(--muted); }
</style>
