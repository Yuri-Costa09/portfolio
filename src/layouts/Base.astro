---
// Fonts are self-hosted (no Google Fonts request, no layout shift from a third party).
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { site } from '../config';

interface Props {
  title?: string;
  description?: string;
  current?: 'writing' | 'notes' | 'projects' | 'cv' | 'home';
}
const { title, description = site.description, current = 'home' } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
const nav = [
  { href: '/writing/', label: 'Writing', key: 'writing' },
  { href: '/notes/', label: 'Notes', key: 'notes' },
  { href: '/projects/', label: 'Projects', key: 'projects' },
  { href: '/cv/', label: 'CV', key: 'cv' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a href="/" class="mark" aria-label={`${site.name}, home`}>{site.name.toLowerCase()}</a>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>
          ))}
          <button class="theme" type="button" aria-label="Switch colour theme" title="Switch colour theme">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="7.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M10 2.5a7.5 7.5 0 0 1 0 15z" fill="currentColor"/></svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <p class="display sign">{site.name.toLowerCase()}</p>
        <ul>
          <li><a href={site.links.github}>GitHub</a></li>
          <li><a href={site.links.linkedin}>LinkedIn</a></li>
          <li><a href={`mailto:${site.links.email}`}>Email</a></li>
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </div>
    </footer>

    <script is:inline>
      document.querySelector('.theme')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch (e) {}
      });
    </script>
  </body>
</html>

<style>
  .site-header { border-bottom: 1px solid var(--rule); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; }
  .mark {
    font-stretch: 125%; font-weight: 900; font-size: 1.375rem;
    letter-spacing: -0.03em; text-decoration: none;
  }
  nav { display: flex; align-items: center; gap: clamp(12px, 2.5vw, 28px); }
  nav a { text-decoration: none; font-weight: 600; font-size: 0.975rem; padding-block: 6px; }
  nav a[aria-current='page'] { box-shadow: inset 0 -3px 0 var(--blue); }
  .theme {
    display: grid; place-items: center; width: 36px; height: 36px;
    border: 1px solid var(--rule); border-radius: 50%;
    background: transparent; color: var(--ink); cursor: pointer;
  }
  .theme:hover { border-color: var(--ink); }

  .site-footer { margin-top: clamp(72px, 12vw, 160px); background: var(--ink); color: var(--paper); }
  .foot { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px; padding-block: 40px 32px; }
  .sign { font-size: clamp(3.5rem, 12vw, 8rem); margin: 0; line-height: 0.8; }
  .foot ul { list-style: none; display: flex; flex-wrap: wrap; gap: 20px; margin: 0; padding: 0; font-weight: 600; }
  .foot a:hover { color: var(--signal); }

  @media (max-width: 520px) {
    .mark { font-size: 1.15rem; }
    nav a { font-size: 0.9rem; }
    .theme { width: 32px; height: 32px; }
  }
</style>
