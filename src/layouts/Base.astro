---
// Fonts are self-hosted (no third-party request).
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { site } from '../config';
import { contributions } from '../data/oss';
import { LANGS, DEFAULT_LANG } from '../lib/logs';
import type { Lang, Version } from '../lib/logs';

interface Props {
  title?: string;
  description?: string;
  current?: 'home' | 'logs';
  lang?: Lang;
  // Every language version of this page, default first (only for translated logs).
  alternates?: Version[];
  // Link preview image (1200×630). Logs pass their own; everything else uses /og.png.
  image?: string;
  type?: 'website' | 'article';
}
const {
  title,
  description = site.description,
  current = 'home',
  lang = DEFAULT_LANG,
  alternates = [],
  image = '/og.png',
  type = 'website',
} = Astro.props;
const abs = (href: string) => new URL(href, Astro.site).href;
const canonical = abs(Astro.url.pathname);
const locale = { en: 'en_US', 'pt-br': 'pt_BR' }[lang];
const pageTitle = title ? `${title} · ${site.name}` : site.title;
const nav = [
  { href: '/logs/', label: 'logs', key: 'logs' },
  { href: '/#experience', label: 'experience', key: 'experience' },
  ...(contributions.length > 0 ? [{ href: '/#oss', label: 'oss', key: 'oss' }] : []),
  { href: '/#links', label: 'links', key: 'links' },
];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={LANGS[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    {alternates.map((a) => <link rel="alternate" hreflang={LANGS[a.lang]} href={abs(a.href)} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={abs(alternates[0].href)} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="yuricosta.dev" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale} />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={abs(image)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? site.title} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a href="/" class="prompt" aria-label={`${site.name}, home`}>{site.name.toLowerCase()}@log:~$</a>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <span>-- EOF --</span>
        <span>© {year} {site.name.toLowerCase()}</span>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header { border-bottom: 1px solid var(--line); }
  .bar {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 4px 16px; min-height: 56px; padding-block: 8px; font-size: 13px;
  }
  .prompt { font-weight: 600; white-space: nowrap; }
  .prompt:hover { color: var(--amber); }
  nav { display: flex; gap: clamp(12px, 2.5vw, 24px); color: var(--mute); }
  nav a { padding-block: 6px; }
  nav a:hover, nav a[aria-current='page'] { color: var(--amber); }

  .site-footer { margin-top: clamp(64px, 10vw, 120px); border-top: 1px solid var(--line); }
  .foot { display: flex; justify-content: space-between; gap: 16px; padding-block: 22px; font-size: 13px; color: var(--mute); }
</style>
